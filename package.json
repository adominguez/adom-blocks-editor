{
  "name": "adom-blocks-editor",
  "version": "0.0.6",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "description": "A versatile WYSIWYG blocks editor component like Gutenberg created with react.",
  "keywords": [
    "nextjs",
    "wysiwyg",
    "blocks-editor",
    "slate",
    "tailwindcss",
    "Gutenberg"
  ],
  "author": "Alberto Domínguez Martín",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "co": "sui-mono commit",
    "dev": "vite",
    "test": "jest",
    "prepare": "rm -rf dist && swc src -d dist && rm -rf dist/**/*.test.js dist/*.d.js dist/main.js dist/__test__",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adominguez/adom-blocks-editor"
  },
